WHATSAPP_ACCESS_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_GRAPH_VERSION=v20.0

# Optional. Use an approved template when the customer has not messaged your business in the last 24 hours.
# WHATSAPP_TEMPLATE_NAME=payment_confirmation
# WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Email delivery for payment confirmations. Brevo can send transactional emails
# to normal customer inboxes after you verify your sender email in Brevo.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=xkeysib-...
EMAIL_FROM=Rent a Ride <your-verified-sender@example.com>

# Optional demo override. Sends every demo email to this address while the dashboard
# still records the customer's intended address.
# EMAIL_DEMO_TO=owner@example.com
